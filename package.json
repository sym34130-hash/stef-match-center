{
  "name": "stef-match-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"STEF_BIND_HOST=127.0.0.1 node --watch server/index.mjs\"",
    "dev:api": "STEF_BIND_HOST=127.0.0.1 node --watch server/index.mjs",
    "dev:web": "vite",
    "lint": "eslint . --max-warnings=0",
    "build": "tsc -b && vite build",
    "test": "node scripts/reconcile-import.mjs",
    "test:pdf": "node --test scripts/pdf-106j.test.mjs",
    "test:pdf:import": "node scripts/verify-pdf-import.mjs",
    "test:deploy": "node scripts/deploy-smoke-test.mjs",
    "test:ui": "playwright test",
    "deploy:package": "node scripts/package-deploy.mjs",
    "preview": "vite preview",
    "start": "node server/index.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "express": "^5.1.0",
    "lucide-react": "^0.539.0",
    "multer": "^2.3.0",
    "pdf-parse": "1.1.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0"
  }
}
